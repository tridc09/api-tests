  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "const baseUrl = pm.environment.get(\"base_url\");\r",
          "const token = pm.environment.get(\"token\")\r",
          "const expiry = Number(pm.environment.get(\"token_expiry\") || 0)\r",
          "\r",
          "if (!token || Date.now() > expiry) {\r",
          "    pm.sendRequest({\r",
          "        url: baseUrl + \"/auth\",\r",
          "        method: \"POST\",\r",
          "        header: {\"Content-Type\": \"application/json; charset=utf-8\"},\r",
          "        body: {\r",
          "            mode: \"raw\",\r",
          "            raw: JSON.stringify(\r",
          "                {\r",
          "                    username: pm.environment.get(\"username\"),\r",
          "                    password: pm.environment.get(\"password\")\r",
          "                }\r",
          "            )\r",
          "        }\r",
          "    }, (err, res) => {\r",
          "        if (err) {\r",
          "            console.error(\"Auth error:\", err);\r",
          "            return;\r",
          "        }\r",
          "        const newToken = res.json().token;\r",
          "        if (!newToken) {\r",
          "            console.error(\"Token dose not exist\", res.json());\r",
          "            return;\r",
          "        }\r",
          "        pm.environment.set(\"token\", newToken);\r",
          "        pm.environment.set(\"token_expiry\", Date.now() + 60 * 10 * 1000);\r",
          "    }\r",
          "    );\r",
          "}"
        ],
        "type": "text/javascript",
        "packages": {}
      }
    }
  ]
}