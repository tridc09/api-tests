          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();\r\n\r\n// Status 200\r\npm.test(\"Status 200\", () => pm.response.to.have.status(200));\r\n// Have all fields required\r\npm.test(\"Have all fields required\", () => pm.expect(body).to.have.all.keys(\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\", \"additionalneeds\"));\r\n// Datatype is correct\r\npm.test(\"Datatype is correct\", () => {\r\n    pm.expect(body.firstname).to.be.a(\"string\");\r\n    pm.expect(body.lastname).to.be.a(\"string\");\r\n    pm.expect(body.totalprice).to.be.a(\"number\");\r\n    pm.expect(body.depositpaid).to.be.a(\"boolean\");\r\n    pm.expect(body.bookingdates).to.be.a(\"object\");\r\n    pm.expect(body.additionalneeds).to.be.a(\"string\");\r\n})\r\n// The value interity\r\npm.test(\"The value interity\", () => {\r\n    pm.expect(body.totalprice).to.be.above(0);\r\n    pm.expect(body.firstname).to.be.not.empty;\r\n})\r\n// Checkout is less than checkin\r\npm.test(\"Checkout is less than checkin\", () => {\r\n    const { checkin, checkout } = body.bookingdates;\r\n    pm.expect(new Date(checkout).getTime()).to.be.above(new Date(checkin).getTime());\r\n})\r\n\r\n\r\n// check header\r\npm.test(\"Content-Type is JSON\", () => {\r\n    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r\n});\r\n\r\npm.test(\"Response time below 2000ms\", () => {\r\n    pm.expect(pm.response.responseTime).to.be.below(2000);\r\n});\r\n"
                ]
              }
            }
