                "type": "text/javascript",
                "exec": [
                  "const  res = pm.response.json();\r\n\r\npm.test(\"Status 200\", () => pm.response.to.have.status(200));\r\npm.test(\"firstname is correct\", () => pm.expect(res.booking.firstname).to.eql(pm.variables.get(\"firstname\")));\r\npm.test(\"totalprice is correct\", () => pm.expect(res.booking.totalprice).to.eql(Number(pm.variables.get(\"totalprice\"))));\r\npm.test(\"checkin is correct\", () => pm.expect(res.booking.bookingdates.checkin).to.eql(pm.variables.get(\"checkin\")));\r\npm.test(\"checkout is correct\", () => pm.expect(res.booking.bookingdates.checkout).to.eql(pm.variables.get(\"checkout\")));\r\n\r\npm.collectionVariables.set(\"bookingId\", res.bookingid);\r\npm.test(\"bookingId is not null\", () => pm.expect(pm.variables.get(\"bookingId\")).to.exist);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const fmt = d => d.toISOString().slice(0, 10);   // định dạng YYYY-MM-DD\r\n\r\nconst checkin = new Date();\r\ncheckin.setDate(checkin.getDate() + 7);           // 7 ngày sau hôm nay\r\nconst checkout = new Date(checkin);\r\ncheckout.setDate(checkout.getDate() + 3);         // ở 3 đêm\r\n\r\npm.variables.set(\"firstname\", pm.variables.replaceIn(\"{{$randomFirstName}}\"));\r\npm.variables.set(\"lastname\", pm.variables.replaceIn(\"{{$randomLastName}}\"));\r\npm.variables.set(\"totalprice\", Math.floor(Math.random() * 900) + 100);\r\npm.variables.set(\"checkin\", fmt(checkin));\r\npm.variables.set(\"checkout\", fmt(checkout));"
                ]
              }
            }
          ],
